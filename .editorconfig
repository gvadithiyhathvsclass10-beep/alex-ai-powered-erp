root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{sh,yml,yaml,json,md,txt,ts,tsx,js,jsx,prisma,css,html}]
end_of_line = lf

[Dockerfile*]
end_of_line = lf

[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot,otf,mp4,webm,pdf,zip,db,sqlite}]
binary = true