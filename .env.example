# =============================================================================
# ALEX AI-Powered ERP - Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local development, or set these in your
# deployment platform (Render, Cloudflare, Neon).
# NEVER commit actual secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
# Public URL of the deployed application (used for canonical links, OAuth callbacks)
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
# Auth callback URL (must match NEXT_PUBLIC_APP_URL for local auth mode)
NEXTAUTH_URL=https://your-app.onrender.com

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Authentication mode: "local" (HMAC sessions) or "firebase"
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local
# Session signing secret - Generate with: openssl rand -base64 32
# MUST remain stable across deployments to preserve existing sessions
AUTH_SECRET=your-32-char-min-secret-for-hmac-sessions

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
# Neon pooled connection string (for application traffic)
# Format: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/alex?sslmode=require
# Neon direct connection string (for Prisma migrations)
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/alex?sslmode=require

# -----------------------------------------------------------------------------
# Encryption (for AI API keys and sensitive data at rest)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# CRITICAL: Must remain stable to decrypt existing encrypted data.
# If rotating, re-encrypt all stored credentials first.
ENCRYPTION_KEY=your-32-character-encryption-key

# -----------------------------------------------------------------------------
# AI Providers (configure at least one for production)
# -----------------------------------------------------------------------------
# AI service mode: "nemotron", "openai", "gemini", "anthropic", etc.
AI_MODE=nemotron

# NVIDIA Nemotron (primary)
# NVIDIA_NEMOTRON_API_KEY=nvapi-xxx
# NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
# NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GOOGLE_GEMINI_API_KEY=xxx
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic
# ANTHROPIC_API_KEY=xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Mistral
# MISTRAL_API_KEY=xxx
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Groq
# GROQ_API_KEY=xxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter
# OPENROUTER_API_KEY=xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Together AI
# TOGETHER_AI_API_KEY=xxx
# TOGETHER_AI_BASE_URL=https://api.together.xyz/v1

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Storage mode: "local" (requires Render Persistent Disk) or "s3" (R2, Cloudflare R2, AWS S3, MinIO)
STORAGE_MODE=s3
# Local storage root (only used when STORAGE_MODE=local)
STORAGE_LOCAL_ROOT=/var/data/alex-storage

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_BUCKET=alex-bucket

# Logical bucket prefixes (used within the physical S3_BUCKET)
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RESOURCES=resources

# File upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg

# -----------------------------------------------------------------------------
# Dropbox Integration (Optional)
# -----------------------------------------------------------------------------
# Create a Dropbox App at https://www.dropbox.com/developers/apps
# DROPBOX_APP_KEY=xxx
# DROPBOX_APP_SECRET=xxx
# DROPBOX_REDIRECT_URI=https://your-app.onrender.com/api/storage/dropbox/callback

# -----------------------------------------------------------------------------
# Background Jobs / Queue (Optional)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email / Notifications (Optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=xxx
# SMTP_PASSWORD=xxx
# EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Push Notifications / Web Push (Optional)
# -----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=xxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# -----------------------------------------------------------------------------
# OCR (for container)
# -----------------------------------------------------------------------------
# TESSERACT_PATH=/usr/bin/tesseract

# -----------------------------------------------------------------------------
# Feature Flags / Limits
# -----------------------------------------------------------------------------
# AI_REQUEST_TIMEOUT_MS=30000