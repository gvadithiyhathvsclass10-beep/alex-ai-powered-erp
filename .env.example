# ALEX - Environment Variables Template
# =============================================================================
# Copy this file to .env.local for development or .env.production for production
# NEVER commit this file with real secrets!
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# AUTHENTICATION
# =============================================================================
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-char-min-secret-for-hmac-sessions
# Optional: Separate CSRF secret (falls back to AUTH_SECRET if not set)
# CSRF_SECRET=your-csrf-secret

# =============================================================================
# DATABASE (PostgreSQL with pgvector required)
# =============================================================================
# Development: Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alex?schema=public"
# Production (Neon): postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/alex?sslmode=require&pgbouncer=true

# =============================================================================
# AI PROVIDERS (at least one required for production)
# =============================================================================
AI_MODE=mock
# NVIDIA Nemotron (Primary)
# NVIDIA_NEMOTRON_API_KEY=nvapi-...
# NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
# NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini
# GOOGLE_GEMINI_API_KEY=...
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Mistral
# MISTRAL_API_KEY=...
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Groq
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Together AI
# TOGETHER_AI_API_KEY=...
# TOGETHER_AI_BASE_URL=https://api.together.xyz/v1
# Universal Gateway (custom)
# UNIVERSAL_AI_API_KEY=...
# UNIVERSAL_AI_BASE_URL=https://your-gateway.example.com/v1

# =============================================================================
# ENCRYPTION (for AI API keys at rest)
# =============================================================================
# Generate with: openssl rand -hex 32
# MUST be stable across deployments to decrypt existing keys!
ENCRYPTION_KEY=your-32-character-encryption-key
# Development fallback (optional)
# ENCRYPTION_KEY_DEV=your-dev-encryption-key

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./storage
# S3-compatible (R2, Cloudflare R2, AWS S3, MinIO)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_BUCKET=alex-uploads
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RESOURCES=resources

# =============================================================================
# EMAIL (optional)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# EMAIL_FROM=noreply@alex.example.com

# =============================================================================
# BACKGROUND JOBS / QUEUE
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# FILE PROCESSING
# =============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg

# =============================================================================
# OCR (optional, for container)
# =============================================================================
# TESSERACT_PATH=/usr/bin/tesseract

# =============================================================================
# PUSH NOTIFICATIONS (optional, Web Push)
# =============================================================================
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@alex.example.com

# =============================================================================
# DROPBOX INTEGRATION (optional)
# =============================================================================
# DROPBOX_APP_KEY=...
# DROPBOX_APP_SECRET=...
# DROPBOX_REDIRECT_URI=http://localhost:3000/api/storage/dropbox/callback

# =============================================================================
# MONITORING (optional)
# =============================================================================
# SENTRY_DSN=https://...
# LOG_LEVEL=debug