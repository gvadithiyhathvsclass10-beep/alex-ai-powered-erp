# ALEX - Production Environment Variables Template
# =============================================================================
# Use this as reference for Render Dashboard environment variables
# NEVER commit this file with real secrets!
# Set these in Render Dashboard > Environment > Environment Variables
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
# Replace with your actual Render service URL after first deploy
NEXT_PUBLIC_APP_URL=https://alex-api.onrender.com
NEXTAUTH_URL=https://alex-api.onrender.com

# =============================================================================
# AUTHENTICATION
# =============================================================================
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local
# Generate with: openssl rand -base64 32
# MUST be stable across deployments to preserve sessions!
AUTH_SECRET=REPLACE_WITH_STABLE_AUTH_SECRET
# Optional: Separate CSRF secret
CSRF_SECRET=REPLACE_WITH_CSRF_SECRET

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Neon connection string with SSL and pgbouncer for connection pooling
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require&pgbouncer=true
DATABASE_URL=REPLACE_WITH_NEON_CONNECTION_STRING

# =============================================================================
# AI PROVIDERS (Configure only providers you actually use)
# =============================================================================
AI_MODE=nemotron

# NVIDIA Nemotron (Primary)
NVIDIA_NEMOTRON_API_KEY=REPLACE_WITH_NVIDIA_KEY
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback providers (at least one recommended)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
GOOGLE_GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
MISTRAL_API_KEY=REPLACE_WITH_MISTRAL_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
TOGETHER_AI_API_KEY=REPLACE_WITH_TOGETHER_KEY

# =============================================================================
# ENCRYPTION
# =============================================================================
# Generate with: openssl rand -hex 32
# CRITICAL: Must remain stable to decrypt existing AI credentials!
ENCRYPTION_KEY=REPLACE_WITH_STABLE_ENCRYPTION_KEY

# =============================================================================
# STORAGE (S3-compatible recommended for production)
# =============================================================================
STORAGE_MODE=s3
# Cloudflare R2, AWS S3, MinIO, etc.
S3_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
S3_BUCKET=REPLACE_WITH_BUCKET_NAME
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RESOURCES=resources

# =============================================================================
# FILE PROCESSING
# =============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,csv,xls,xlsx,ppt,pptx,png,jpg,jpeg

# =============================================================================
# BACKGROUND JOBS (Upstash Redis or Render Redis)
# =============================================================================
REDIS_URL=REPLACE_WITH_REDIS_URL

# =============================================================================
# EMAIL (Optional)
# =============================================================================
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# DROPBOX INTEGRATION (Optional)
# =============================================================================
DROPBOX_APP_KEY=REPLACE_WITH_DROPBOX_APP_KEY
DROPBOX_APP_SECRET=REPLACE_WITH_DROPBOX_APP_SECRET
DROPBOX_REDIRECT_URI=https://alex-api.onrender.com/api/storage/dropbox/callback

# =============================================================================
# MONITORING (Optional)
# =============================================================================
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
LOG_LEVEL=info