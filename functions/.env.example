# Firebase Functions Environment Variables
# Copy to .env and fill in your values
# In production, use Firebase Secret Manager instead

# =============================================================================
# FIREBASE (Auto-configured in production)
# =============================================================================
# FIREBASE_PROJECT_ID=your-project-id

# =============================================================================
# ENCRYPTION
# =============================================================================
ENCRYPTION_KEY=your-32-character-encryption-key-here

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================
# NVIDIA Nemotron (Primary)
NVIDIA_NEMOTRON_API_KEY=nvapi-...
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GOOGLE_GEMINI_API_KEY=...

# Anthropic
ANTHROPIC_API_KEY=...

# Other Providers
MISTRAL_API_KEY=...
GROQ_API_KEY=...
OPENROUTER_API_KEY=...
TOGETHER_AI_API_KEY=...

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Email
SENDGRID_API_KEY=...

# SMS
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=...

# =============================================================================
# DATABASE (If Functions need direct DB access)
# =============================================================================
# DATABASE_URL=postgresql://user:pass@host:5432/alex

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_VECTOR_SEARCH=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_SCHEDULED_JOBS=true
ENABLE_DOCUMENT_PROCESSING=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=30

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info