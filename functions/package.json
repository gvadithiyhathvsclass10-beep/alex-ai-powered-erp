{
  "name": "functions",
  "version": "1.0.0",
  "description": "ALEX Firebase Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google-cloud/vertexai": "^1.0.0",
    "@google/generative-ai": "^0.24.1",
    "@alex/shared-types": "workspace:*",
    "@alex/shared-utils": "workspace:*",
    "@alex/validation-schemas": "workspace:*",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^5.5.0",
    "date-fns": "^3.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "lodash": "^4.17.21",
    "mammoth": "^1.7.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.0.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.0"
  },
  "private": true
}